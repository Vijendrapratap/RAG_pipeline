# Claude Code session state
.claude/

# Secrets and local overrides
.env
.env.*.local
docker-compose.override.yml

# Local-only build log (per user decision 2026-05-17)
doc.md

# Phase 9 eval reports (per-run JSON; keep .gitkeep)
eval/results/*.json

# Model-comparison run outputs (generated; timestamped JSON/MD dumps)
eval/compare_results/

# Data and runtime state.
# `data/*` rather than `data/`: git cannot re-include a file whose parent
# directory is excluded, and the Phase 17 rule tables live here and must be
# reviewable in a diff.
data/*
!data/normalize_rules.json
!data/normalize_review.md
!data/aliases.json
!data/synonyms.json
!data/gazetteer.json
!data/gazetteer_review.md
dead_letter/
ingest_progress.sqlite
ingest.log
ingest.log.*
pageindex.log
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (dashboard build artifacts)
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Editor / OS junk
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
