# Where the Vite dev server should proxy `/api` requests. Unset = the
# normal local default (http://localhost:8080). Change this only if your
# rag-api backend is on a different host/port during development.
VITE_API_TARGET=http://localhost:8080

# Override only if hosting the UI on a *different origin* than the API
# (e.g. CDN + remote API). Same-origin (the container in Phase F) needs
# this empty — relative `/api/...` requests work as-is.
# VITE_API_BASE=
