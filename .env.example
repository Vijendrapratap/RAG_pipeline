# transcript-rag environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Generate secrets with: openssl rand -hex 32

# --- Secrets ---
POSTGRES_PASSWORD=replace_me
QDRANT_API_KEY=replace_me

# --- Service URLs (host-side scripts; containers use docker-compose DNS) ---
# Phase F: the Tantivy `:8765` sidecar is gone — Tantivy runs in-process
# inside the rag-api container; ingestion writes to TANTIVY_DIR directly.
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
RERANKER_URL=http://localhost:7997
POSTGRES_DSN=postgresql://owui:${POSTGRES_PASSWORD}@localhost:5432/openwebui

# --- Collection / model names ---
QDRANT_COLLECTION=transcripts
# File-level summary index (one vector per transcript). Populated by
# `python -m ingestion.build_summary_index`; powers summary / two-stage search.
QDRANT_SUMMARY_COLLECTION=transcript_summaries
EMBED_MODEL=bge-m3

# --- Data paths (WSL2: Windows D:\ is mounted at /mnt/d) ---
# RAW_TRANSCRIPTS_DIR: where the chunker reads transcripts from.
# RAW_TRANSCRIPTS_BASE_DIR: Phase 12 — root above the event/date/track
#   hierarchy. When set, each file's path is parsed for metadata
#   (event, date, track type, season) and attached to the chunk for
#   filter-aware retrieval. Usually equal to RAW_TRANSCRIPTS_DIR.
#   Unset to disable path-metadata enrichment.
RAW_TRANSCRIPTS_DIR="/mnt/d/Transcription whisperx/Output"
RAW_TRANSCRIPTS_BASE_DIR="/mnt/d/Transcription whisperx/Output"
PROCESSED_CHUNKS_DIR=/mnt/d/Vishvas-rag-pipeline/data/processed
TANTIVY_DIR=/mnt/d/Vishvas-rag-pipeline/data/tantivy
DEAD_LETTER_DIR=./dead_letter

# --- Ingestion tuning ---
INGEST_BATCH_SIZE=32
INGEST_PER_FILE_TIMEOUT_SEC=1800
INGEST_MAX_FILE_SIZE_MB=500

# --- Dashboard API (rag_api) — replaces Open WebUI ---
# CHAT_PROVIDER: which backend writes the final answer.
#   "ollama"     — strictly local (default; preserves the PRD's design)
#   "openrouter" — opt-in cloud fallback for A/B-testing larger models that
#                  don't fit the GPU (e.g. qwen/qwen3.6-27b). When set,
#                  retrieved chunks are sent to OpenRouter — only enable if
#                  you accept the privacy trade-off.
CHAT_PROVIDER=ollama
# CHAT_MODEL: Ollama model that writes the final answer when
#   CHAT_PROVIDER=ollama. Swap to the fine-tuned 26B model here when it is
#   ready — no code change needed.
CHAT_MODEL=qwen3.5:9b
# TAG_MODEL: Ollama model for the offline Phase 13 enrichment pass (content
#   tags + summaries via ingestion.enrich_content_tags). qwen3.5:9b is a
#   thinking model; the enrichment call forces think=false so format=json
#   returns a non-empty response instead of routing output into `thinking`.
TAG_MODEL=qwen3.5:9b
# --- OpenRouter (used when CHAT_PROVIDER=openrouter OR when an OpenRouter
#     model is selected from the frontend dropdown) ---
# OPENROUTER_API_KEY: get from https://openrouter.ai/keys . Leave empty if
#   no OpenRouter models are listed in AVAILABLE_OPENROUTER_MODELS. NEVER
#   commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.6-27b
# Cap on response tokens (incl. any <think> reasoning). Raise if answers
# are getting truncated.
OPENROUTER_MAX_TOKENS=4096
# Optional attribution headers shown on OpenRouter's analytics page.
OPENROUTER_REFERER=
OPENROUTER_TITLE=transcript-rag

# --- Selectable models in the frontend dropdown ---
# Two comma-separated lists of additional models to offer in the dashboard's
# "Model" dropdown. The default model (CHAT_MODEL / OPENROUTER_MODEL above)
# is always included automatically — these lists are *extras*. Leave both
# empty to hide the dropdown entirely (single-model deployment).
#
# Examples (uncomment + edit to enable):
# AVAILABLE_OLLAMA_MODELS=qwen3:8b,qwen3:14b,gemma3:12b
# AVAILABLE_OPENROUTER_MODELS=qwen/qwen3.6-27b,google/gemma-3-27b-it
AVAILABLE_OLLAMA_MODELS=
AVAILABLE_OPENROUTER_MODELS=
# DASHBOARD_PASSWORD: shared password for the dashboard. Empty = auth
#   disabled (local dev only). Generate with: openssl rand -hex 16
DASHBOARD_PASSWORD=replace_me
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8080
# React dev-server origins allowed through CORS (comma-separated).
RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Retrieval tuning (optional — defaults match the old Open WebUI valves).
RAG_CANDIDATES=40
RAG_TOP_K=8
RAG_BM25_WEIGHT=0.65
RAG_QUOTE_BM25_WEIGHT=0.85
# Two-stage retrieval: files kept by stage-1 summary search.
RAG_SUMMARY_TOP_FILES=6

# --- PageIndex (opt-in alternate retrieval backend; A/B vs the hybrid path) ---
# Reasoning-based "vectorless" retrieval over local LLM-built section trees.
# Leave RETRIEVAL_BACKEND=hybrid for the default locked pipeline; set it to
# "pageindex" to flip the deployment default, or send `backend=pageindex` per
# request from the dashboard's Engine picker. Trees are built offline by
# `python -m ingestion.build_pageindex` into PAGEINDEX_DIR. Reasoning uses the
# local Ollama model (PAGEINDEX_MODEL, defaults to CHAT_MODEL) — stays local.
RETRIEVAL_BACKEND=hybrid
PAGEINDEX_DIR=/mnt/d/Vishvas-rag-pipeline/data/pageindex
# PAGEINDEX_MODEL=qwen2.5:7b-instruct-q4_K_M
# Candidate documents the reasoning step considers per query (stage-1 fan-out).
PAGEINDEX_CANDIDATE_DOCS=5
# Section size: consecutive chunks grouped into one tree node up to this many
# tokens. Smaller = finer retrieval but slower/costlier tree builds.
PAGEINDEX_MAX_TOKENS_PER_NODE=1200

# Answer-model generation options.
CHAT_NUM_CTX=8192
# Prefill batch size (ollama num_batch). Wider = faster time-to-first-token on
# large RAG prompts; no effect on output quality. 512 is ollama's default.
CHAT_NUM_BATCH=1024
CHAT_TEMPERATURE=0.2
# Anti-repetition penalty (ollama repeat_penalty). 1.0 = off. 1.1 stops the
# rare degenerate loop where a small model repeats a sentence for hundreds of
# tokens, without harming normal phrasing. Quality-safe.
CHAT_REPEAT_PENALTY=1.1
CHAT_TIMEOUT_S=300

# --- Track panel media roots (mounted :ro into rag-api) ---
# Paths are resolved relative to the compose file, NOT to /mnt/d — Docker
# Desktop's WSL distro does not mount Windows drives there, and a /mnt/d
# source lands in a silently EMPTY directory. `GET /api/health` reports
# `transcripts_mounted` / `isolated_mounted` so an empty mount is visible.
#
# ISOLATED_DIR = the folder holding the per-model `.ckpt` trees, not one of them.
TRANSCRIPTS_DIR="../Transcription whisperx/Output"
ISOLATED_DIR="../GuruAudio/Output"
