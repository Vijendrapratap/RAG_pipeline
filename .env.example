# transcript-rag environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Generate secrets with: openssl rand -hex 32

# --- Secrets ---
WEBUI_SECRET_KEY=replace_me
POSTGRES_PASSWORD=replace_me
QDRANT_API_KEY=replace_me

# --- Service URLs (host-side scripts; containers use docker-compose DNS) ---
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
TANTIVY_URL=http://localhost:8765
RERANKER_URL=http://localhost:7997
POSTGRES_DSN=postgresql://owui:${POSTGRES_PASSWORD}@localhost:5432/openwebui

# --- Collection / model names ---
QDRANT_COLLECTION=transcripts
EMBED_MODEL=bge-m3

# --- Data paths (HOST paths; under WSL2 use /mnt/... or a Linux-side path) ---
RAW_TRANSCRIPTS_DIR=/data/raw-transcripts
# Phase 12: root above the audio-folder hierarchy. When set, every
# input file's path is parsed for metadata (event, date, track type,
# season) and attached to the chunk for filter-aware retrieval. Usually
# the same as RAW_TRANSCRIPTS_DIR but kept separate so chunkers can also
# be invoked on subdirectories without losing the base reference.
# Leave unset (or unexport) to disable path-metadata enrichment.
RAW_TRANSCRIPTS_BASE_DIR=/data/raw-transcripts
PROCESSED_CHUNKS_DIR=/data/processed
TANTIVY_DIR=/data/tantivy
DEAD_LETTER_DIR=./dead_letter

# --- Ingestion tuning ---
INGEST_BATCH_SIZE=32
INGEST_PER_FILE_TIMEOUT_SEC=1800
INGEST_MAX_FILE_SIZE_MB=500
